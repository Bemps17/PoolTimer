{
  "name": "h8timer-mirror",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "TimerRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TimerRoom"] }],
  // S1 : nouvelles connexions par IP (cf. CONNECT_RATE dans src/mirror/limits.ts), en mémoire, sans écriture.
  "ratelimits": [{ "name": "CONNECT_LIMITER", "namespace_id": "1001", "simple": { "limit": 40, "period": 60 } }]
}
